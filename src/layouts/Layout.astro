---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} class="no-js">
  <head>
    <BaseHead {...props} />
    <!--
      Quita `no-js` antes del primer paint. Si el JS está bloqueado la clase
      se queda y el CSS muestra todo el contenido sin animación.
    -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:font-medium focus:text-navy-900"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
