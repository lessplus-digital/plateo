---
/**
 * Todo el <head>: meta, canonical, Open Graph, Twitter Card y JSON-LD.
 * Es el único sitio donde se tocan tags de SEO — no los repartas por las páginas.
 */
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Ruta o URL de la imagen social (1200x630). */
  image?: string;
  /** Excluir del índice de Google (gracias, páginas legales y landings de campaña). */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  noindex = false,
} = Astro.props;

// Home usa el título completo; el resto lleva sufijo de marca.
const pageTitle = title ? `${title} · ${SITE.titleTemplate}` : SITE.defaultTitle;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL(image, Astro.site);

// Datos estructurados: le dicen a Google qué es Plateo, no solo qué dice la página.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: SITE.lang,
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      name: SITE.name,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description: SITE.description,
      url: SITE.url,
    },
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta name="theme-color" content={SITE.themeColor} />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="sitemap" href="/sitemap-index.xml" />

{/* Open Graph — lo que se ve al pegar el link en WhatsApp, LinkedIn, Facebook */}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
