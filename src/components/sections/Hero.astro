---
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';
import Mark from '../ui/Mark.astro';
import Doodle from '../ui/Doodle.astro';
import Sticker from '../ui/Sticker.astro';
import Ticket from '../ui/Ticket.astro';
import { LINKS } from '../../consts';

/**
 * Hero asimétrico: el argumento a la izquierda y, a la derecha, el objeto que
 * Plateo reemplaza — la comanda de papel.
 *
 * A propósito NO hay captura del panel aquí. Esa aparece más abajo, en la demo
 * en vivo, y verla dos veces la desactiva. Lo que tiene que quedar de esta
 * pantalla es el problema, no el software.
 */

/** Lo que hoy hace el mismo trabajo que Plateo, y por qué se cae. */
const REEMPLAZA = ['la libreta de la caja', 'el grito a la cocina', 'el Excel de los domingos'];
---

<section class="relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
  <!--
    Fondo: retícula tenue que se desvanece. Sustituye al degradado radial
    difuminado de rigor, que a estas alturas es el sello de cualquier plantilla.
  -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_50%_0%,black,transparent_72%)] opacity-[0.5]"
    aria-hidden="true"
  >
    <div
      class="size-full"
      style="background-image: linear-gradient(to right, var(--color-navy-100) 1px, transparent 1px), linear-gradient(to bottom, var(--color-navy-100) 1px, transparent 1px); background-size: 4rem 4rem;"
    >
    </div>
  </div>

  <div class="container-page">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
      <!-- ================= Argumento ================= -->
      <div>
        <Reveal variant="fade">
          <p
            class="inline-flex items-center gap-2 rounded-full border border-line-strong bg-surface px-3.5 py-1.5 text-xs text-text-muted"
          >
            <span class="size-1.5 rounded-full bg-accent"></span>
            Hecho en Colombia para restaurantes de Colombia
          </p>
        </Reveal>

        <Reveal
          as="h1"
          delay={70}
          blur={14}
          class="mt-6 text-[2.6rem] leading-[1.04] font-semibold tracking-tight text-balance md:text-6xl"
        >
          Tus pedidos de WhatsApp dejan de vivir en
          <Mark variant="underline" tone="mint" delay={620}>el celular</Mark> del mesero.
        </Reveal>

        <Reveal delay={150} class="mt-6 max-w-xl text-lg text-text-muted text-pretty">
          <p>
            Un asistente atiende el chat a toda hora, arma el pedido con tu menú real y lo
            manda al tablero de cocina. Tú ves todo desde una sola pantalla.
          </p>
        </Reveal>

        <Reveal delay={220} class="mt-9 flex flex-wrap items-center gap-3">
          <Button href={LINKS.whatsapp} variant="primary" size="lg" external arrow>
            Probarlo por WhatsApp
          </Button>
          <Button href="#en-vivo" variant="secondary" size="lg">Ver cómo funciona</Button>
        </Reveal>

        <!-- Nota manuscrita colgando del CTA, con su flecha -->
        <Reveal delay={300} class="mt-5 flex items-start gap-2 pl-2">
          <Doodle shape="arrow-short" tone="violet" width={44} rotate={-8} delay={520} />
          <p class="handwritten mt-1 text-text-muted">
            te respondemos con el menú de tu propio local
          </p>
        </Reveal>

        <Reveal delay={360} class="mt-11 border-t border-line pt-6">
          <p class="text-xs tracking-[0.14em] text-text-faint uppercase">Reemplaza</p>
          <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
            {
              REEMPLAZA.map((item) => (
                <li class="flex items-center gap-2 text-sm text-text-muted">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M3 3l8 8M11 3l-8 8"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      class="text-text-faint"
                    />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </Reveal>
      </div>

      <!-- ================= La comanda ================= -->
      <div class="relative mx-auto w-full max-w-sm lg:mx-0 lg:justify-self-end">
        <!-- Dos tiquetes asomando por detrás: la pila de comandas de una noche -->
        <div
          class="ticket-edge absolute -top-5 right-4 h-40 w-[85%] rounded-sm bg-navy-100"
          style="transform: rotate(4.5deg)"
          aria-hidden="true"
        >
        </div>
        <div
          class="ticket-edge absolute -top-2.5 left-3 h-44 w-[88%] rounded-sm bg-navy-50"
          style="transform: rotate(-2.5deg)"
          aria-hidden="true"
        >
        </div>

        <Reveal variant="tilt" delay={260} blur={16} class="relative">
          <Ticket label="Pizzería Vera · Domicilio" code="#1042" rotate={-1.5}>
            <ul class="space-y-1.5 text-sm">
              <li class="flex justify-between gap-4">
                <span>1 Napolitana grande</span>
                <span class="tnum">48.000</span>
              </li>
              <li class="flex justify-between gap-4">
                <span>2 Gaseosa 400 ml</span>
                <span class="tnum">10.000</span>
              </li>
            </ul>

            <div class="mt-3 flex justify-between gap-4 border-t border-dashed border-line-strong pt-3 text-sm font-bold">
              <span>TOTAL</span>
              <span class="tnum">$58.000</span>
            </div>

            <dl class="mt-4 space-y-1 text-[0.7rem] text-text-muted">
              <div class="flex justify-between gap-4">
                <dt>Cliente</dt>
                <dd class="text-text">Camila M.</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt>Entrega</dt>
                <dd class="text-text">Calle 93 #12-40</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt>Tomado por</dt>
                <dd class="text-text">Plateo · 8:14 p. m.</dd>
              </div>
            </dl>
          </Ticket>
        </Reveal>

        <!-- Sello de confirmado, encima del papel -->
        <Reveal
          variant="scale"
          delay={620}
          blur={0}
          class="absolute -right-1 -bottom-3 z-10 sm:-right-4"
        >
          <Sticker tone="mint" rotate={-7}>
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M2.5 7.5l3 3 6-7"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            Confirmado en 40 segundos
          </Sticker>
        </Reveal>

        <Doodle
          shape="sparkle"
          tone="violet"
          width={34}
          delay={760}
          class="absolute -top-8 -left-2 hidden sm:block"
        />
      </div>
    </div>
  </div>
</section>
