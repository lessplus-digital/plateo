---
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';
import { LINKS } from '../../consts';
---

<section class="relative overflow-hidden pt-40 pb-24 md:pt-48 md:pb-32">
  <!-- Halo de fondo. `pointer-events-none` para que no bloquee clics. -->
  <div
    class="pointer-events-none absolute -top-1/3 left-1/2 -z-10 aspect-square w-[min(90rem,180%)] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,var(--color-brand-700)_0%,transparent_62%)] opacity-25 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-page">
    <Reveal variant="fade">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-ink-800 bg-ink-900/60 px-4 py-1.5 text-xs text-ink-300"
      >
        <span class="size-1.5 rounded-full bg-brand-500"></span>
        Pedidos por WhatsApp, sin app y sin comisiones por venta
      </p>
    </Reveal>

    <Reveal as="h1" delay={80} class="mt-7 max-w-4xl text-5xl font-semibold tracking-tight text-balance md:text-7xl">
      Tu restaurante recibe pedidos por WhatsApp.
      <span class="text-gradient">Plateo los pone en orden.</span>
    </Reveal>

    <Reveal delay={160} class="mt-6 max-w-2xl text-lg text-ink-300 text-pretty md:text-xl">
      <p>
        Un asistente atiende el chat 24/7 y cada pedido entra directo a un tablero en
        tiempo real: cocina, domicilios, clientes y reservas en una sola pantalla.
      </p>
    </Reveal>

    <Reveal delay={240} class="mt-10 flex flex-wrap items-center gap-3">
      <Button href={LINKS.whatsapp} variant="primary" size="lg" external>
        Ver una demo en vivo
      </Button>
      <Button href="#como-funciona" variant="secondary" size="lg">Cómo funciona</Button>
    </Reveal>

    <!--
      TODO: reemplazar por <VideoLoop /> con la grabación real del dashboard.
      Mientras tanto, este bloque reserva el espacio para no mover el layout.
    -->
    <Reveal variant="scale" delay={320} class="mt-20">
      <div
        class="aspect-[16/10] w-full rounded-2xl border border-ink-800 bg-gradient-to-b from-ink-900 to-ink-950 shadow-2xl shadow-black/50"
      >
        <div class="grid h-full place-items-center text-sm text-ink-500">
          Video del producto (usar el componente VideoLoop)
        </div>
      </div>
    </Reveal>
  </div>
</section>
