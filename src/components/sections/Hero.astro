---
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';
import Mark from '../ui/Mark.astro';
import Doodle from '../ui/Doodle.astro';
import Sticker from '../ui/Sticker.astro';
import { LINKS } from '../../consts';

/**
 * Hero asimétrico: el argumento a la izquierda y, a la derecha, el agente
 * trabajando.
 *
 * La conversación del teléfono está elegida para que en un solo hilo se vean
 * TRES capacidades distintas —reserva, pedido y cobro—, no un pedido de pizza
 * más. Es lo que hace que el visual diga algo en vez de solo decorar.
 *
 * No se repite con <LiveDemo />: allí la conversación se reproduce en el
 * tiempo y lo que importa es el tablero reaccionando; aquí es un objeto fijo y
 * anotado a mano, y lo que importa es la amplitud de lo que el agente resuelve.
 */

/** Lo que hoy hace el mismo trabajo que Plateo, y por qué se cae. */
const REEMPLAZA = ['la libreta de la caja', 'el grito a la cocina', 'el Excel de los domingos'];

/** Hilo del teléfono. `tipo` cambia cómo se pinta la burbuja. */
interface Mensaje {
  de: 'cliente' | 'plateo';
  texto: string;
  /** Adjunto que se dibuja encima del texto. */
  tipo?: 'comprobante';
}

const CHAT: Mensaje[] = [
  { de: 'cliente', texto: '¡Buenas! Una napolitana grande y dos gaseosas 🍕' },
  {
    de: 'plateo',
    texto: '¡Claro! Van $58.000. ¿Le agrego borde de queso por $6.000?',
  },
  { de: 'cliente', texto: 'Sí porfa, y sin cebolla' },
  {
    de: 'plateo',
    texto: 'Anotado: sin cebolla 📝 Total $64.000. ¿Te lo llevo a la Calle 93 #12-40?',
  },
  { de: 'cliente', tipo: 'comprobante', texto: 'Esa misma. Ahí te transferí' },
  { de: 'plateo', texto: 'Pago confirmado ✅ Sale del horno en 25 min.' },
];
---

<section class="relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
  {/*
    Fondo: retícula tenue que se desvanece. Sustituye al degradado radial
    difuminado de rigor, que a estas alturas es el sello de cualquier plantilla.
  */}
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-50 [mask-image:radial-gradient(ellipse_at_50%_0%,black,transparent_72%)]"
    aria-hidden="true"
  >
    <div
      class="size-full"
      style="background-image: linear-gradient(to right, var(--color-navy-100) 1px, transparent 1px), linear-gradient(to bottom, var(--color-navy-100) 1px, transparent 1px); background-size: 4rem 4rem;"
    >
    </div>
  </div>

  <div class="container-page">
    <div class="grid items-center gap-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
      {/* ================= Argumento ================= */}
      <div>
        <Reveal variant="fade">
          <p
            class="inline-flex items-center gap-2 rounded-full border border-line-strong bg-surface px-3.5 py-1.5 text-xs text-text-muted"
          >
            <span class="size-1.5 rounded-full bg-accent"></span>
            Hecho en Colombia para restaurantes de Colombia
          </p>
        </Reveal>

        <Reveal
          as="h1"
          delay={70}
          blur={14}
          class="mt-6 text-[2.6rem] leading-[1.06] font-semibold tracking-tight text-balance md:text-6xl"
        >
          Un agente IA atiende WhatsApp. Tu equipo atiende{' '}
          <Mark variant="underline" tone="mint" delay={620}>el local</Mark>.
        </Reveal>

        <Reveal delay={150} class="mt-6 max-w-xl text-lg text-text-muted text-pretty">
          <p>
            Toma pedidos, aparta mesas y responde dudas a cualquier hora, con tu menú y tus
            precios. Todo entra ordenado a un solo tablero, sin comisión por venta.
          </p>
        </Reveal>

        {/*
          El primario va a `whatsappDemo` —el agente en producción de una
          pizzería— y NO a `whatsapp`, que es nuestro canal de ventas. Es el
          único sitio del sitio que apunta ahí, y a propósito: aquí el visitante
          todavía no quiere hablar con un comercial, quiere ver si la cosa
          funciona. La forma más corta de demostrarlo es dejarle pedir a un
          Plateo de verdad.

          Quien ya quiere hablar con nosotros tiene el "Agendar una demo" del
          header, que baja al cierre de la página.
        */}
        <Reveal delay={220} class="mt-9 flex flex-wrap items-center gap-3">
          <Button href={LINKS.whatsappDemo} variant="primary" size="lg" external arrow>
            Probarlo por WhatsApp
          </Button>
          <Button href="#en-vivo" variant="secondary" size="lg">Ver cómo funciona</Button>
        </Reveal>

        {/*
          Nota al margen con su flecha.

          Va con `arrow-flow` y no con `arrow-short`, y la diferencia es la
          posición de la punta dentro del dibujo. En `arrow-short` la punta cae
          en la esquina INFERIOR derecha (y=83% de su caja) y apunta hacia
          abajo: alinearla con un texto que está a su derecha y en la misma
          línea es imposible, porque haga lo que haga el flex, la punta queda
          por debajo del renglón. Se intentó con `items-end` y el texto seguía
          flotando por encima.

          `arrow-flow` es casi horizontal y su punta está a media altura
          (y=17 de 34, el 50% exacto). Con `items-center` la punta cae sola
          sobre el centro del texto, sin ajustes a ojo.

          Que el texto lleve `rotate(-1.2deg)` da igual: la utilidad
          `handwritten` gira desde `left center`, justo el punto al que apunta
          la flecha, así que ahí el desplazamiento es cero.

          Los tres números del ajuste fino están puestos A OJO, mirando la
          página, y así deben quedarse:

          - `gap-0.5` en vez de `gap-2.5`: acerca el texto 8px a la punta. El
            hueco visual real era mayor que el gap, porque la punta del dibujo
            está en x=107 de 120 y quedaban ~6px de caja vacía detrás.
          - `-translate-y-[5px]` en el <p>: lo sube, sin mover la flecha ni
            afectar al layout. Va en la propiedad `translate`, independiente
            del `transform: rotate()` de `handwritten`, así que se componen en
            vez de pisarse.
          - `mt-8` en vez de `mt-5`: despega el bloque de los botones.

          Aviso para quien venga a "corregir" esto con matemáticas: ya se
          intentó. Se calculó la punta exacta proyectando (107,17) del viewBox
          con `getScreenCTM()` y se comparó contra una estimación del centro
          óptico del texto; salía que había que BAJARLO 9px. Se hizo y se veía
          claramente peor. El fallo estaba en la estimación del centro óptico
          —un factor inventado sobre el cuerpo de la fuente—, no en el ojo.
          Para alinear un garabato con una tipografía manuscrita, mira la
          pantalla.
        */}
        <Reveal delay={300} class="mt-8 flex items-center gap-0.5 pl-1">
          <Doodle shape="arrow-flow" tone="violet" width={54} rotate={-3} delay={520} />
          {/*
            La nota cambió de trabajo cuando el botón pasó a apuntar al agente
            de demostración. Antes prometía «te contestamos con el menú de tu
            propio local», que sigue siendo verdad pero ya lo dice el cierre de
            la página; aquí hacía falta avisar de a QUIÉN se le está
            escribiendo. Sin esto, quien pulse cree que nos escribe a nosotros,
            recibe una carta de pizzas y se va pensando que se equivocó de
            número. Que el objeto de la derecha sea justo un chat de pizzería
            remata el aviso.
          */}
          <p class="handwritten -translate-y-[5px] text-text-muted">
            es una pizzería de prueba: pídele algo
          </p>
        </Reveal>

        {/*
          Lo que Plateo deja atrás.

          Cada entrada va tachada con <Mark variant="strike" />, que existe
          exactamente para esto («tachado, para lo que Plateo deja atrás») y no
          se estaba usando. Antes cada línea llevaba delante una equis de 14px:
          tres iconos idénticos repetidos que no decían nada que el tachado no
          diga mejor, y que además son el gesto por defecto de cualquier lista
          de «antes / después». Quitándolos el bloque tiene MENOS elementos que
          antes, no más.

          El `whitespace-nowrap` no es cosmético: <Mark /> es `inline-block` y
          si una entrada partiera en dos líneas el trazo tacharía el bloque
          entero en vez de la última línea. Con el `flex-wrap` de la lista, lo
          que se reparte en varias filas son las entradas completas.

          El escalonado del `delay` hace que se tachen una detrás de otra al
          entrar en pantalla, en vez de las tres a la vez.
        */}
        <Reveal delay={360} class="mt-11 border-t border-line pt-6">
          <p class="text-xs tracking-[0.14em] text-text-faint uppercase">Reemplaza</p>
          <ul class="mt-4 flex flex-wrap items-center gap-x-7 gap-y-3">
            {
              REEMPLAZA.map((item, i) => (
                <li class="text-[0.95rem] whitespace-nowrap text-text-muted">
                  <Mark variant="strike" tone="violet" delay={780 + i * 140}>
                    {item}
                  </Mark>
                </li>
              ))
            }
          </ul>
        </Reveal>
      </div>

      {/* ================= El agente trabajando ================= */}
      <div class="relative flex justify-center lg:justify-end">
        {/*
          Anotaciones a mano señalando dos momentos del hilo. Solo en pantallas
          anchas: por debajo de lg no hay hueco a la izquierda del teléfono y
          acabarían encima de la conversación.

          Se anclan por la DERECHA, no por la izquierda. La columna es bastante
          más ancha que el teléfono, así que `left-0` las mandaba al borde de
          la columna y la flecha quedaba señalando al vacío. Con `right-[17rem]`
          —el teléfono mide 18rem— el borde derecho de la anotación cae justo
          dentro de la carcasa, y la punta toca lo que señala.
        */}
        <Reveal
          variant="left"
          delay={820}
          blur={0}
          class="absolute top-[27%] right-[17rem] z-20 hidden items-center gap-1.5 lg:flex"
        >
          <p class="handwritten max-w-24 text-right text-text-muted">sugiere adiciones</p>
          <Doodle shape="arrow-short" tone="violet" width={38} rotate={-45} delay={980} />
        </Reveal>

        <Reveal
          variant="left"
          delay={940}
          blur={0}
          class="absolute right-[17rem] bottom-[14%] z-20 hidden items-center gap-1.5 lg:flex"
        >
          <p class="handwritten max-w-24 text-right text-text-muted">y confirma el pago</p>
          <Doodle shape="arrow-short" tone="violet" width={34} rotate={-38} delay={1100} />
        </Reveal>

        <Reveal variant="tilt" delay={260} blur={16} class="relative z-10">
          {/*
            Carcasa y pantalla en dos tonos, del más oscuro al más claro:
            navy-975 (marco) -> navy-950 (pantalla) -> navy-800 (burbujas del
            agente). Antes la pantalla era el navy de marca y las burbujas
            navy-800: apenas 0.06 de diferencia en luminosidad, así que el
            móvil se leía como una mancha morada plana. Ahora hay 0.05 y 0.115
            entre escalones, y el escalón más oscuro va desaturado.
          */}
          <div
            class="w-[17.5rem] rounded-[2.25rem] bg-navy-975 p-2.5 shadow-2xl shadow-navy-900/25 sm:w-[18rem]"
          >
            <div class="overflow-hidden rounded-[1.75rem] bg-navy-950">
              {/* Cabecera del chat */}
              <div class="flex items-center gap-2.5 border-b border-line-inverse px-4 py-3">
                <div
                  class="grid size-8 shrink-0 place-items-center rounded-full bg-accent text-xs font-semibold text-navy-900"
                  aria-hidden="true"
                >
                  PV
                </div>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-[0.8rem] font-medium text-text-inverse">Pizzería</p>
                  <p class="text-[0.65rem] text-accent">en línea · responde al instante</p>
                </div>
              </div>

              {/* Hilo */}
              <div class="flex flex-col gap-2 px-3.5 py-4">
                {
                  CHAT.map((msg) => (
                    <div
                      class:list={[
                        'max-w-[86%] rounded-2xl px-3 py-2 text-[0.78rem] leading-snug',
                        msg.de === 'cliente'
                          ? 'self-end rounded-br-sm bg-accent text-navy-900'
                          : 'self-start rounded-bl-sm bg-navy-800 text-text-inverse',
                      ]}
                    >
                      {msg.tipo === 'comprobante' && (
                        <div
                          class="mb-1.5 flex items-center gap-2 rounded-lg bg-navy-900/15 px-2 py-1.5"
                          aria-hidden="true"
                        >
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 5.5h16v13H4z" />
                            <path d="M4 15l5-4 4 3 3-2.5 4 3.5" />
                            <path d="M9 9.5v.1" />
                          </svg>
                          <span class="text-[0.68rem] font-medium">comprobante.jpg</span>
                        </div>
                      )}
                      <p>{msg.texto}</p>
                    </div>
                  ))
                }
              </div>

              {/* Barra de escritura */}
              <div class="flex items-center gap-2 border-t border-line-inverse px-4 py-3">
                <span class="flex-1 text-[0.7rem] text-navy-400">Escribe un mensaje…</span>
                <span class="text-sm font-bold text-accent" aria-hidden="true">➤</span>
              </div>
            </div>
          </div>
        </Reveal>

        {/*
          Sello colgando de la esquina inferior derecha. Estaba en `bottom-6`,
          es decir tumbado sobre la barra de escritura, y se leía como parte de
          la interfaz en vez de como algo pegado encima. Descolgado en diagonal
          solo pisa la esquina redondeada, que es como se pega una pegatina.

          El desplazamiento se queda dentro del padding de `container-page`
          (2rem en md+), así que no lo recorta el `overflow-hidden` de la
          sección.
        */}
        <Reveal
          variant="scale"
          delay={700}
          blur={0}
          class="absolute -right-3 -bottom-4 z-30 sm:-right-5"
        >
          <Sticker tone="mint" rotate={-7}>
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M2.5 7.5l3 3 6-7"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            Sin apps ni comisiones
          </Sticker>
        </Reveal>

        <Doodle
          shape="sparkle"
          tone="violet"
          width={30}
          delay={860}
          class="absolute -top-4 right-2 z-30 hidden sm:block"
        />
      </div>
    </div>
  </div>
</section>
