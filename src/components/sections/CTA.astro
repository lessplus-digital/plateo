---
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';
import Mark from '../ui/Mark.astro';
import Doodle from '../ui/Doodle.astro';
import Logo from '../ui/Logo.astro';
import { LINKS } from '../../consts';

/**
 * Cierre. Va en navy y pegado al footer (sin margen entre ambos), de forma que
 * el final de la página sea un solo bloque oscuro y no dos franjas distintas.
 */
---

<section id="precios" class="scroll-mt-24 bg-surface-inverse pt-24 pb-28 md:pt-32 md:pb-36">
  <div class="container-page">
    <div class="relative mx-auto max-w-3xl text-center">
      <!-- El isotipo enorme, casi transparente, de marca de agua -->
      <Logo
        variant="mark"
        height={220}
        decorative
        class="pointer-events-none absolute -top-24 left-1/2 -z-0 -translate-x-1/2 text-white/[0.04]"
      />

      <div class="relative">
        <Reveal variant="fade">
          <Doodle shape="sparkle" tone="mint" width={38} delay={380} class="mx-auto" />
        </Reveal>

        <Reveal
          as="h2"
          delay={80}
          blur={12}
          class="mt-6 text-4xl font-semibold text-balance text-text-inverse md:text-6xl"
        >
          Te lo montamos con
          <Mark variant="underline" tone="mint" delay={600}>tu propio menú</Mark>
        </Reveal>

        <Reveal delay={160} class="mx-auto mt-6 max-w-xl text-lg text-text-inverse-muted text-pretty">
          <p>
            Nos mandas la carta, la cargamos y te dejamos pedir desde tu WhatsApp como si
            fueras un cliente más. Sin instalar nada y sin compromiso.
          </p>
        </Reveal>

        <Reveal delay={230} class="mt-10 flex flex-wrap justify-center gap-3">
          <Button href={LINKS.whatsapp} variant="primary" size="lg" external arrow>
            Escribirnos por WhatsApp
          </Button>
          <Button href={`mailto:${LINKS.email}`} variant="inverse" size="lg">
            Prefiero un correo
          </Button>
        </Reveal>

        <Reveal delay={300} class="mt-6">
          <p class="handwritten text-text-inverse-muted">contestamos nosotros, no un bot</p>
        </Reveal>
      </div>
    </div>
  </div>
</section>
