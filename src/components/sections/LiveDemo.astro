---
import Reveal from '../ui/Reveal.astro';
import Sticker from '../ui/Sticker.astro';
import Mark from '../ui/Mark.astro';

/**
 * Demo en vivo: la conversación de WhatsApp a la izquierda y el tablero de
 * cocina reaccionando a la derecha.
 *
 * El orden importa. En Plateo la causa es el chat y el efecto es el tablero,
 * así que el chat va primero en el sentido de lectura. Cada mensaje puede
 * llevar colgado un evento de tablero, de modo que las dos columnas corren
 * sobre UNA sola línea de tiempo y no hay forma de que se desincronicen.
 *
 * La sección se renderiza entera en el HTML, con la conversación completa y el
 * pedido ya entregado. El JS solo la rebobina y la reproduce. Así, sin JS, se
 * sigue contando la historia completa en vez de quedar un cuadro vacío, y no
 * hay salto de layout al arrancar.
 *
 * El guion vive solo aquí: el script lee los tiempos y los eventos de los
 * atributos `data-*`, nunca de una copia paralela en JS.
 */

type BoardEvent =
  | { do: 'add'; col: 'recibido' }
  | { do: 'move'; col: 'preparacion' | 'camino' }
  | { do: 'stat' };

interface Step {
  from: 'cliente' | 'plateo';
  text: string;
  /** Tarjeta que acompaña al mensaje. */
  card?: 'menu' | 'cuenta';
  /** Qué le pasa al tablero justo después de este mensaje. */
  board?: BoardEvent;
}

const CHAT: Step[] = [
  { from: 'cliente', text: '¡Buenas! ¿Están abiertos para domicilio?' },
  {
    from: 'plateo',
    text: 'Hola Camila 👋 Sí, hasta las 11 p. m. Este es el menú de hoy:',
    card: 'menu',
  },
  { from: 'cliente', text: 'Una napolitana grande y dos gaseosas' },
  {
    from: 'plateo',
    text: '¿Te lo llevo a la Calle 93 #12-40, como la vez pasada?',
    card: 'cuenta',
    board: { do: 'add', col: 'recibido' },
  },
  { from: 'cliente', text: 'Sí, a esa misma 🙌' },
  {
    from: 'plateo',
    text: 'Pedido confirmado ✅ Ya está en el horno. Te llega en unos 35 minutos.',
    board: { do: 'move', col: 'preparacion' },
  },
  {
    from: 'plateo',
    text: 'Salió con Andrés en la moto 🛵 Placa XKD-42.',
    board: { do: 'move', col: 'camino' },
  },
  {
    from: 'plateo',
    text: '¿Todo bien con el pedido? Cuéntame y le paso la nota al cocinero.',
    board: { do: 'stat' },
  },
];

const COLUMNS = [
  { id: 'recibido', label: 'Recibido', dot: 'bg-accent-2' },
  { id: 'preparacion', label: 'En preparación', dot: 'bg-status-warm' },
  { id: 'camino', label: 'En camino', dot: 'bg-accent' },
] as const;

/** Pedidos de atrezo: el tablero no puede arrancar vacío, ningún local lo está. */
const AMBIENT = [
  { col: 'recibido', n: '#1041', who: 'Mesa 7', items: '1 hawaiana · 2 cerveza', total: '61.000' },
  { col: 'preparacion', n: '#1039', who: 'Mesa 4', items: '2 margarita · 1 limonada', total: '74.000' },
  { col: 'camino', n: '#1038', who: 'Julián R.', items: '1 pepperoni grande', total: '46.000' },
] as const;

/** El pedido que nace durante la demo. En el HTML ya aparece entregado. */
const LIVE = {
  n: '#1042',
  who: 'Camila M.',
  items: '1 napolitana grande · 2 gaseosa',
  total: '58.000',
};

/** Ventas del turno, antes y después de que entre el pedido de Camila. */
const TOTALS = { before: '$181.000', after: '$239.000' };
---

<section id="en-vivo" class="bg-surface-inverse py-24 md:py-32">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <Reveal variant="fade">
        <p class="text-xs font-semibold tracking-[0.18em] text-accent uppercase">
          Un jueves cualquiera, 8:14 p. m.
        </p>
      </Reveal>

      <Reveal
        as="h2"
        delay={80}
        class="mt-4 text-4xl font-semibold text-balance text-text-inverse md:text-5xl"
      >
        El cliente escribe.
        <span class="mt-1 block text-accent">
          La cocina <Mark variant="underline" tone="mint" delay={560}>ya lo sabe</Mark>.
        </span>
      </Reveal>

      <Reveal delay={160} class="mt-6 text-lg text-text-inverse-muted text-pretty">
        <p>
          Nadie apunta en una libreta ni grita el pedido desde la caja. Esto es lo que
          pasa, en el mismo orden en que pasa.
        </p>
      </Reveal>
    </div>

    {/*
      `data-demo` es la raíz que busca el script. Al arrancar añade
      `is-playing`, que oculta los mensajes para poder revelarlos por turnos.
    */}
    <Reveal variant="tilt" delay={220} blur={16} class="mt-14">
      <div
        data-demo
        data-total-before={TOTALS.before}
        data-total-after={TOTALS.after}
        class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-line-inverse bg-navy-950 shadow-2xl shadow-black/40"
      >
        {/* Barra de ventana del panel */}
        <div class="flex items-center gap-3 border-b border-line-inverse px-4 py-3">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="size-2.5 rounded-full bg-navy-700"></span>
            <span class="size-2.5 rounded-full bg-navy-700"></span>
            <span class="size-2.5 rounded-full bg-navy-700"></span>
          </div>
          <p class="flex-1 truncate text-center text-xs text-text-inverse-muted">
            panel.plateo.app — Pizzería · Turno noche
          </p>
          <span class="hidden items-center gap-1.5 text-xs text-accent sm:inline-flex">
            <span class="size-1.5 animate-pulse rounded-full bg-accent"></span>
            en vivo
          </span>
        </div>

        <div class="grid gap-px bg-line-inverse lg:grid-cols-[22rem_1fr]">
          {/* ============ Izquierda: la conversación ============ */}
          <div class="bg-navy-950 p-5">
            <div class="mb-4 flex items-center gap-3">
              <div
                class="grid size-9 shrink-0 place-items-center rounded-full bg-accent text-sm font-semibold text-navy-900"
                aria-hidden="true"
              >
                CM
              </div>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium text-text-inverse">Camila M.</p>
                <p class="text-xs text-accent">en línea</p>
              </div>
              <span class="text-xs text-navy-400">WhatsApp</span>
            </div>

            {/*
              Alto fijo: la conversación crece hacia arriba y los mensajes
              viejos se van saliendo por el borde superior, como en un chat de
              verdad. Sin alto fijo, el bloque entero daría tumbos en cada
              vuelta del bucle.
            */}
            <div
              data-chat
              class="flex h-[27rem] flex-col justify-end gap-2.5 overflow-hidden [mask-image:linear-gradient(to_bottom,transparent,black_3rem)]"
            >
              {
                CHAT.map((step, i) => (
                  <div
                    data-step={i}
                    data-from={step.from}
                    data-card={step.card}
                    data-board={step.board ? JSON.stringify(step.board) : undefined}
                    class:list={[
                      'max-w-[85%] rounded-2xl px-3.5 py-2.5 text-sm leading-snug',
                      step.from === 'cliente'
                        ? 'self-end rounded-br-sm bg-accent text-navy-900'
                        : 'self-start rounded-bl-sm bg-navy-800 text-text-inverse',
                    ]}
                  >
                    {step.card === 'menu' && (
                      <div class="mb-2 space-y-1 rounded-xl bg-navy-950/60 p-2.5 text-xs">
                        <p class="font-medium text-accent">Menú · Pizzería </p>
                        {[
                          ['Napolitana grande', '48.000'],
                          ['Pepperoni grande', '46.000'],
                          ['Hawaiana mediana', '38.000'],
                        ].map(([name, price]) => (
                          <p class="flex justify-between gap-3 text-text-inverse-muted">
                            <span>{name}</span>
                            <span class="tnum">${price}</span>
                          </p>
                        ))}
                      </div>
                    )}

                    {step.card === 'cuenta' && (
                      <div class="mb-2 rounded-xl bg-navy-950/60 p-2.5 text-xs">
                        <p class="flex justify-between gap-3 text-text-inverse-muted">
                          <span>1 napolitana grande</span>
                          <span class="tnum">$48.000</span>
                        </p>
                        <p class="flex justify-between gap-3 text-text-inverse-muted">
                          <span>2 gaseosa 400 ml</span>
                          <span class="tnum">$10.000</span>
                        </p>
                        <p class="mt-1.5 flex justify-between gap-3 border-t border-line-inverse pt-1.5 font-semibold text-accent">
                          <span>Total</span>
                          <span class="tnum">$58.000</span>
                        </p>
                      </div>
                    )}

                    <p>{step.text}</p>
                  </div>
                ))
              }

              {/* "Escribiendo…". Solo aparece durante la reproducción. */}
              <div
                data-typing
                hidden
                class="flex w-16 items-center justify-center gap-1 self-start rounded-2xl rounded-bl-sm bg-navy-800 px-3.5 py-3"
              >
                {
                  [0, 1, 2].map((i) => (
                    <span
                      class="size-1.5 animate-typing rounded-full bg-navy-400"
                      style={{ animationDelay: `${i * 160}ms` }}
                    />
                  ))
                }
              </div>
            </div>
          </div>

          {/* ============ Derecha: el tablero de cocina ============ */}
          <div class="bg-navy-950 p-5">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
              <p class="text-sm font-medium text-text-inverse">Pedidos de hoy</p>
              <p class="text-xs text-navy-400">
                Ventas del turno
                <span data-total class="tnum ml-1.5 font-semibold text-accent">
                  {TOTALS.after}
                </span>
              </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-3">
              {
                COLUMNS.map((col) => (
                  <div class="rounded-xl bg-navy-900/70 p-2.5">
                    <p class="mb-2.5 flex items-center gap-1.5 px-1 text-[0.7rem] font-semibold tracking-wide text-navy-300 uppercase">
                      <span class:list={['size-1.5 rounded-full', col.dot]} aria-hidden="true" />
                      {col.label}
                    </p>

                    <div data-col={col.id} class="flex min-h-24 flex-col gap-2">
                      {AMBIENT.filter((o) => o.col === col.id).map((o) => (
                        <article class="rounded-lg border border-line-inverse bg-navy-950 p-2.5">
                          <p class="flex items-baseline justify-between gap-2">
                            <span class="tnum text-xs font-semibold text-text-inverse">{o.n}</span>
                            <span class="truncate text-[0.7rem] text-navy-400">{o.who}</span>
                          </p>
                          <p class="mt-1 text-[0.7rem] leading-snug text-navy-300">{o.items}</p>
                          <p class="tnum mt-1.5 text-xs font-medium text-accent">${o.total}</p>
                        </article>
                      ))}

                      {/*
                        El pedido de la demo se pinta ya entregado. El script lo
                        saca del DOM al empezar y lo va devolviendo columna a
                        columna; sin script se queda aquí, que es el final.
                      */}
                      {col.id === 'camino' && (
                        <article
                          data-live
                          class="rounded-lg border-2 border-accent bg-navy-900 p-2.5 ring-3 ring-mint-400/15"
                        >
                          <p class="flex items-baseline justify-between gap-2">
                            <span class="tnum text-xs font-semibold text-accent">{LIVE.n}</span>
                            <span class="truncate text-[0.7rem] text-navy-400">{LIVE.who}</span>
                          </p>
                          <p class="mt-1 text-[0.7rem] leading-snug text-navy-200">{LIVE.items}</p>
                          <p class="tnum mt-1.5 text-xs font-semibold text-accent">${LIVE.total}</p>
                        </article>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </Reveal>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-3">
      <Sticker tone="mint" rotate={-3}>Sin comisión por venta</Sticker>
      <p class="max-w-md text-sm text-text-inverse-muted">
        Un pedido real, con los tiempos reales. Ni el cliente instala nada, ni el mesero
        deja de atender mesas.
      </p>
    </div>
  </div>
</section>

<style>
  /*
    Estado de reproducción. Solo se activa cuando el script arranca: si el JS
    no llega nunca, todo queda visible tal y como lo pintó el servidor.

    Los mensajes pendientes van con `display: none`, no con `opacity: 0`. Con
    opacidad seguirían ocupando su hueco, y como la conversación se alinea
    abajo (`justify-end`) los 8 mensajes invisibles empujarían al visible
    fuera del marco por arriba. Al ocultarlos de verdad, la conversación crece
    desde abajo como la de un chat.

    Por eso la entrada es `animation` y no `transition`: una transición no
    dispara al pasar de `display: none` a visible; una animación sí.
  */
  [data-demo].is-playing [data-step] {
    display: none;
  }

  [data-demo].is-playing [data-step].is-shown {
    display: block;
    animation: msg-in 0.32s var(--ease-out-cubic);
  }

  @keyframes msg-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  /*
    El atributo `hidden` por sí solo no basta: la utilidad `flex` del propio
    globo tiene la misma especificidad y va después en la hoja, así que ganaría
    y el indicador no se ocultaría nunca. Con dos atributos, esta regla manda.
  */
  [data-typing][hidden] {
    display: none;
  }

  /* La tarjeta del pedido al aterrizar en una columna nueva */
  [data-live].is-landing {
    animation: land 0.45s var(--ease-out-cubic);
  }

  @keyframes land {
    from {
      opacity: 0;
      transform: translateX(-0.75rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  /**
   * Reproductor de la demo. Vanilla, sin dependencias.
   *
   * Una sola línea de tiempo recorre los mensajes; cada uno puede disparar de
   * paso un movimiento en el tablero. Al terminar espera y vuelve a empezar.
   * Todo el guion se lee del DOM (`data-from`, `data-card`, `data-board`), así
   * que editar el array del frontmatter basta para cambiar la demo.
   */
  type BoardEvent =
    | { do: 'add'; col: string }
    | { do: 'move'; col: string }
    | { do: 'stat' };

  /** Ritmo en ms. Calibrado para que se lea sin prisa pero sin esperas muertas. */
  const TYPING = 1100; // cuánto "escribe" Plateo antes de contestar
  const READING = 850; // pausa antes de un mensaje del cliente
  const AFTER = 1400; // pausa tras un mensaje normal
  const AFTER_CARD = 2100; // pausa tras un mensaje con tarjeta (hay más que leer)
  const LOOP_GAP = 3600; // respiro antes de volver a empezar

  function initDemo(root: HTMLElement) {
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const typing = root.querySelector<HTMLElement>('[data-typing]');
    const totalEl = root.querySelector<HTMLElement>('[data-total]');
    const liveCard = root.querySelector<HTMLElement>('[data-live]');

    const columns = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('[data-col]').forEach((el) => {
      if (el.dataset.col) columns.set(el.dataset.col, el);
    });

    if (steps.length === 0 || !liveCard) return;

    // Con movimiento reducido no se reproduce nada: el HTML del servidor ya
    // muestra la conversación entera y el tablero completo.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /*
      Se marca como "en reproducción" ya mismo, no al empezar el bucle. Si se
      esperara al observer, la conversación entera estaría a la vista y se
      vaciaría de golpe justo cuando el usuario llega a la sección.
    */
    root.classList.add('is-playing');

    const { totalBefore = '', totalAfter = '' } = root.dataset;

    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    const rewind = () => {
      steps.forEach((step) => step.classList.remove('is-shown'));
      liveCard.remove();
      if (totalEl) totalEl.textContent = totalBefore;
      if (typing) typing.hidden = true;
    };

    const applyBoard = (event: BoardEvent) => {
      if (event.do === 'stat') {
        if (totalEl) totalEl.textContent = totalAfter;
        return;
      }

      const target = columns.get(event.col);
      if (!target) return;

      // Mover y añadir son la misma operación: appendChild saca la tarjeta de
      // donde estuviera. La diferencia solo existe en el guion, para que se
      // lea qué está pasando.
      target.appendChild(liveCard);

      // Reinicia la animación de aterrizaje aunque el nodo sea siempre el mismo
      liveCard.classList.remove('is-landing');
      void liveCard.offsetWidth;
      liveCard.classList.add('is-landing');
    };

    const play = async () => {
      for (;;) {
        rewind();
        await wait(700);

        for (const step of steps) {
          if (step.dataset.from === 'plateo' && typing) {
            typing.hidden = false;
            await wait(TYPING);
            typing.hidden = true;
          } else {
            await wait(READING);
          }

          step.classList.add('is-shown');

          const board = step.dataset.board;
          if (board) applyBoard(JSON.parse(board) as BoardEvent);

          await wait(step.dataset.card ? AFTER_CARD : AFTER);
        }

        await wait(LOOP_GAP);
      }
    };

    // Arranca solo cuando la sección está a la vista, y una única vez.
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        observer.disconnect();
        play();
      },
      { rootMargin: '-60px' },
    );

    observer.observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-demo]').forEach(initDemo);
</script>
