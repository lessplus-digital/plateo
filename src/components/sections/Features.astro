---
import type { ComponentProps } from 'astro/types';
import Reveal from '../ui/Reveal.astro';
import Icon from '../ui/Icon.astro';
import Mark from '../ui/Mark.astro';
import Doodle from '../ui/Doodle.astro';

/**
 * Las capacidades del producto, con lo que cada una le ahorra o le gana al
 * local pegado detrás.
 *
 * Es la segunda pantalla, justo antes de <LiveDemo />: aquí el visitante
 * decide si esto le sirve o si sigue bajando por inercia. Tiene que dar la
 * medida de TODO lo que hace el servicio y pasarle el turno al demo, que es el
 * momento fuerte de la página. Un cliente que llega agotado al demo ya no lo
 * mira.
 *
 * De ahí las tres reglas de las que no conviene salirse:
 *
 * 1. Dos o tres líneas por capacidad, nunca un párrafo. Lo justo para que se
 *    entienda el mecanismo —qué hace y cómo—, y ni una frase más: lo demás lo
 *    enseña el demo mucho mejor de lo que puede contarlo un texto.
 * 2. Cada `body` abre en el resultado y cierra en la consecuencia; la función
 *    va en medio, si cabe. "Manda el recordatorio" es una casilla de una tabla
 *    comparativa; "menos mesas apartadas que nadie ocupa" es el motivo por el
 *    que alguien paga. Y el título nombra lo que el dueño ya llama así:
 *    "Métricas", no "Números"; "Pasa a un humano", no "Relevo humano". Si hay
 *    que explicar la palabra, la palabra está mal.
 * 3. Nada de cuadrícula de tarjetas iguales. Media docena de tarjetas con
 *    icono, título y párrafo del mismo largo es exactamente la forma que tiene
 *    una página generada; además, cuenta que todas las cosas pesan igual, y no
 *    es verdad. Aquí van en una lista con filetes, y solo la primera —el
 *    agente— se sale de la norma con sus tres etiquetas.
 *
 * El titular tampoco cuenta capacidades. Decía "Siete trabajos que se
 * automatizan": un inventario, y encima obligaba a revisar el número cada vez
 * que se toca la lista. Ahora nombra lo que el local se lleva, y la lista
 * puede crecer sin que haya que tocar nada más.
 *
 * Antes esto era una cuadrícula con tarjeta navy, gráfica de barras y cuadros
 * de color en menta y violeta. Se quitó todo: demasiada tinta y demasiado
 * ruido para una sección de paso.
 */

/**
 * Lo que separa al agente de un bot de árbol de opciones.
 *
 * La disponibilidad NO va aquí aunque sea el argumento más fuerte: ya la dice
 * el párrafo de la izquierda, y repetirla en una etiqueta gasta uno de los
 * tres huecos en algo que el lector acaba de leer.
 */
const RASGOS = ['sin respuestas fijas', 'recuerda a cada cliente', 'más de 50 idiomas'];

interface Capacidad {
  /** El nombre sale del propio <Icon />, así no se pueden desincronizar. */
  icon: ComponentProps<typeof Icon>['name'];
  title: string;
  body: string;
  /** Solo el agente lleva etiquetas: es el producto, el resto es lo que hace. */
  rasgos?: boolean;
}

const CAPACIDADES: Capacidad[] = [
  {
    icon: 'agente',
    title: 'Agente de IA',
    body: 'Atiende como un miembro de tu equipo, no como un menú de opciones. Entiende mensajes, audios y conversaciones completas para responder con tu carta, tus precios y las reglas de tu restaurante.',
    rasgos: true,
  },
  {
    icon: 'pedido',
    title: 'Pedidos',
    body: 'Toma pedidos, modifica productos, sugiere adiciones, calcula el total y recibe el comprobante de pago. A cocina solo llegan pedidos completos y listos para preparar.',
  },
  {
    icon: 'reservas',
    title: 'Reservas',
    body: 'Agenda, reprograma y cancela reservas desde WhatsApp. También recuerda la visita al cliente para reducir las mesas que quedan vacías.',
  },
  {
    icon: 'atencion',
    title: 'Preguntas frecuentes',
    body: 'Responde al instante preguntas sobre horarios, domicilio, medios de pago, ubicación o cualquier duda frecuente, sin interrumpir el trabajo del equipo.',
  },
  {
    icon: 'clientes',
    title: 'Clientes',
    body: 'Recuerda quién es cada cliente, qué suele pedir y dónde vive. Cada conversación se vuelve más rápida y personalizada que la anterior.',
  },
  {
    icon: 'estadisticas',
    title: 'Métricas',
    body: 'Consulta ventas, ticket promedio, horas pico y productos más vendidos para tomar mejores decisiones todos los días.',
  },
  {
    icon: 'resenas',
    title: 'Reseñas',
    body: 'Después de cada pedido, Plateo pregunta cómo fue la experiencia. Los clientes satisfechos llegan a Google; los problemas llegan primero a ti.',
  },
  {
    icon: 'soporte',
    title: 'Pasa a un humano',
    body: 'Cuando una conversación necesita intervención, cualquier persona del equipo puede entrar al chat. Plateo retoma la atención automáticamente cuando termina.',
  },
];
---

<section id="producto" class="bg-surface-sunken py-24 md:py-32">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      {/* ===== Izquierda: el encabezado, quieto mientras pasa la lista ===== */}
      <div class="lg:sticky lg:top-28 lg:self-start">
        <Reveal variant="fade">
          <p class="text-xs font-semibold tracking-[0.18em] text-accent-2-ink uppercase">
            El producto
          </p>
        </Reveal>

        {/*
          Tres verbos, y ese es el argumento entero: el agente contesta, el
          agente vende, y lo que sale de ahí queda cuadrado sin que nadie lo
          transcriba.

          El corte de línea está medido en la columna real, que es estrecha
          (0.8fr de la rejilla). "Atiende, vende y deja el turno cuadrado"
          partía en tres con un "y deja el" suelto en medio; esta parte en dos
          por la conjunción, que es donde se lee bien. Si tocas el titular,
          míralo en la página: `text-balance` no reparte estas líneas.

          "Contesta" y no "atiende" porque el h1 ya dice "Un agente IA atiende
          WhatsApp", y repetir el verbo del hero en la segunda pantalla suena a
          que no hay nada más que contar.

          El <Mark /> va en las ÚLTIMAS palabras, como en el hero ("el local")
          y en Steps ("una semana"), y no es manía de simetría: el trazo se
          dibuja por debajo de la línea base, así que marcando "vende" —final
          de la primera línea— el subrayado cruzaba por encima de "el turno".
          Se midió: 20px de solape. En la última línea el trazo cae al aire.
        */}
        <Reveal as="h2" delay={70} class="mt-4 text-4xl font-semibold text-balance md:text-5xl">
          Contesta, vende y cuadra{' '}
          <Mark variant="underline" tone="mint" delay={600}>el turno</Mark>
        </Reveal>

        {/*
          El párrafo abre en lo que se pierde HOY, no en lo que trae Plateo. Es
          la única frase de la página que nombra el costo de no hacer nada, y va
          aquí porque es donde el visitante decide si sigue bajando.

          Lo que decía antes —"ninguno le suma una pantalla nueva, ninguno cobra
          comisión"— era cierto pero ya estaba dicho dos veces más arriba: en el
          párrafo del hero y en el sello "Sin apps ni comisiones". Gastar la
          segunda pantalla repitiendo el hero es gastarla.
        */}
        <Reveal delay={140} class="mt-6 text-lg text-text-muted text-pretty">
          <p>
            Cada mensaje que se queda sin responder es un pedido que se fue al de la esquina.
            El agente los contesta todos, a cualquier hora y con tu carta en la mano, y lo que
            se cierra entra solo al tablero de la cocina.
          </p>
        </Reveal>

        <Reveal delay={200} class="mt-8 flex items-center gap-2">
          <a
            href="#en-vivo"
            class="group inline-flex items-center gap-2 text-sm font-medium text-accent-2-ink underline-offset-4 hover:underline"
          >
            Míralo tomando un pedido
            <svg
              width="15"
              height="15"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
              class="transition-transform duration-200 ease-out-cubic group-hover:translate-y-0.5"
            >
              <path
                d="M8 2.5v11M3.5 9 8 13.5 12.5 9"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>

          <Doodle shape="squiggle" tone="mint" width={72} rotate={-2} delay={640} class="ml-1" />
        </Reveal>
      </div>

      {/* ===== Derecha: la lista ===== */}
      <ul>
        {
          CAPACIDADES.map((cap, i) => (
            <Reveal
              as="li"
              delay={i * 55}
              blur={6}
              class="group border-t border-line first:border-t-0"
            >
              <div class="flex items-start gap-5 py-6 transition-transform duration-200 ease-out-cubic group-hover:translate-x-1">
                <span class="mt-0.5 shrink-0 text-accent-ink" aria-hidden="true">
                  <Icon name={cap.icon} size={24} />
                </span>

                <div class="min-w-0">
                  <h3 class="text-lg font-semibold">{cap.title}</h3>
                  <p class="mt-1 text-[0.95rem] text-text-muted text-pretty">{cap.body}</p>

                  {cap.rasgos && (
                    <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-1.5">
                      {RASGOS.map((rasgo) => (
                        <li class="rounded-full bg-accent-soft px-2.5 py-1 text-xs text-accent-ink">
                          {rasgo}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </Reveal>
          ))
        }
      </ul>
    </div>
  </div>
</section>
