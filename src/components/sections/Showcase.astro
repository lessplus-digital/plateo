---
import Carousel from '../ui/Carousel.astro';
import Reveal from '../ui/Reveal.astro';

/**
 * Vitrina del producto. Cada slide debería llevar un <VideoLoop /> con la
 * grabación real de esa pantalla; por ahora son marcadores de posición.
 *
 * TODO: grabar las cuatro pantallas y sustituir los marcadores. El comando de
 * ffmpeg está documentado dentro de VideoLoop.astro.
 */
const SLIDES = [
  {
    title: 'Tablero de pedidos',
    body: 'La pantalla que vive abierta en la cocina durante todo el turno.',
  },
  {
    title: 'Ficha del cliente',
    body: 'Qué pidió, cuándo, a dónde se le llevó y cuánto lleva gastado.',
  },
  {
    title: 'Menú y disponibilidad',
    body: 'Se acabó la hawaiana: se apaga desde el celular y el bot deja de ofrecerla.',
  },
  {
    title: 'Cierre del día',
    body: 'Ventas, ticket promedio y los platos que más salieron, sin cuadrar nada a mano.',
  },
];
---

<section class="py-24 md:py-32">
  <div class="container-page">
    <div class="max-w-2xl">
      <Reveal variant="fade">
        <p class="text-xs font-semibold tracking-[0.18em] text-accent-2-ink uppercase">
          Por dentro
        </p>
      </Reveal>

      <Reveal as="h2" delay={70} class="mt-4 text-4xl font-semibold text-balance md:text-5xl">
        Las cuatro pantallas que de verdad se usan
      </Reveal>

      <Reveal delay={140} class="mt-5 text-lg text-text-muted text-pretty">
        <p>
          No hay veinte módulos ni un menú lateral con cosas que nadie abre. Estas son
          todas.
        </p>
      </Reveal>
    </div>
  </div>

  <!-- El carrusel se sale del contenedor a propósito: sugiere que hay más. -->
  <Reveal variant="fade" delay={180} class="container-page mt-12">
    <Carousel label="Pantallas del producto" class="mask-edges">
      {
        SLIDES.map(({ title, body }) => (
          <article class="w-[82vw] shrink-0 snap-start sm:w-[27rem]">
            <div class="aspect-[4/3] overflow-hidden rounded-xl border border-line bg-surface-sunken">
              {/*
                TODO: sustituir por
                <VideoLoop src="/videos/x.mp4" webm="/videos/x.webm"
                           poster="/videos/x.jpg" width={1280} height={960}
                           label={title} class="size-full object-cover" />
              */}
              <div class="grid h-full place-items-center text-xs text-text-faint">{title}</div>
            </div>
            <h3 class="mt-4 text-base font-semibold">{title}</h3>
            <p class="mt-1 text-sm text-text-muted">{body}</p>
          </article>
        ))
      }
    </Carousel>
  </Reveal>
</section>
