/*
  viewBox recortados al bounding box real de los trazos, no al lienzo del
  archivo (que trae aire de sobra por los cuatro lados). Así el logo se alinea
  ópticamente con el texto de al lado sin márgenes mágicos.
*/
const MARK_BOX = { viewBox: '0 0 559.5 413.88', ratio: 559.5 / 413.88 };
const WORD_BOX = { viewBox: '134.4 443.01 458.12 132.3', ratio: 458.12 / 132.3 };
const STACK_BOX = { viewBox: '0 0 592.52 575.31', ratio: 592.52 / 575.31 };

// `as const` para que 'true' no se ensanche a string: los tipos de Astro
// esperan el literal, no cualquier cadena.
const a11y = decorative
  ? ({ 'aria-hidden': 'true' } as const)
  : ({ role: 'img', 'aria-label': 'Plateo' } as const);

// En el lockup horizontal el isotipo va algo más alto que las letras: la "o"
// y la "p" tienen ascendentes cortos y, a la misma altura, la marca se vería
// hundida. Un 128% lo compensa ópticamente.
const markHeight = Math.round(height * 1.28);
const wordHeight = height;
---

{
  variant === 'mark' && (
    <svg
      viewBox={MARK_BOX.viewBox}
      width={Math.round(height * MARK_BOX.ratio)}
      height={height}
      fill="currentColor"
      class={className}
      {...a11y}
    >
      {MARK_PATHS.map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}

{
  variant === 'wordmark' && (
    <svg
      viewBox={WORD_BOX.viewBox}
      width={Math.round(height * WORD_BOX.ratio)}
      height={height}
      fill="currentColor"
      class={className}
      {...a11y}
    >
      {WORD_PATHS.map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}

{
  variant === 'stacked' && (
    <svg
      viewBox={STACK_BOX.viewBox}
      width={Math.round(height * STACK_BOX.ratio)}
      height={height}
      fill="currentColor"
      class={className}
      {...a11y}
    >
      {[...MARK_PATHS, ...WORD_PATHS].map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}

{
  variant === 'lockup' && (
    <span class:list={['inline-flex items-center', className]} {...a11y}>
      <svg
        viewBox={MARK_BOX.viewBox}
        width={Math.round(markHeight * MARK_BOX.ratio)}
        height={markHeight}
        fill="currentColor"
        aria-hidden="true"
      >
        {MARK_PATHS.map((d) => (
          <path d={d} />
        ))}
      </svg>
      <svg
        viewBox={WORD_BOX.viewBox}
        width={Math.round(wordHeight * WORD_BOX.ratio)}
        height={wordHeight}
        fill="currentColor"
        aria-hidden="true"
        style={{ marginLeft: `${Math.round(height * 0.24)}px` }}
      >
        {WORD_PATHS.map((d) => (
          <path d={d} />
        ))}
      </svg>
    </span>
  )
}
