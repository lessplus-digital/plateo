// Trazos del logotipo: las seis letras de "plateo".
const WORD_PATHS = [
  'M134.4,575.31v-105.81h22.37v8.72c6.19-7.93,13.8-11.42,25.06-11.42,22.84,0,38.86,17.92,38.86,42.99s-16.66,41.72-38.71,41.72c-10.15,0-17.45-3.01-23.79-9.99v33.79h-23.79ZM157.08,508.85c0,11.42,8.72,20.46,19.99,20.46s19.83-8.72,19.83-20.15-8.57-20.15-19.99-20.15-19.83,8.88-19.83,19.83h0Z',
