---
/**
 * Logo oficial de Plateo, en línea: sin request extra, sin CLS y sin depender
 * de que cargue una imagen antes de que se vea la marca.
 *
 * El archivo original (images/LogoPlateo.svg) trae isotipo y logotipo apilados
 * en un lienzo de 593x576. Aquí están separados porque casi nunca se usan en
 * esa proporción: el header quiere una versión horizontal, el favicon quiere
 * solo el isotipo.
 *
 * Los trazos usan `fill="currentColor"`, así que el logo hereda el color del
 * texto que lo contiene: menta sobre navy, navy sobre blanco. No fijes el
 * color aquí dentro.
 */
interface Props {
  /**
   * - `lockup`   isotipo + logotipo en horizontal. Header y footer.
   * - `mark`     solo el isotipo.
   * - `wordmark` solo el logotipo.
   * - `stacked`  la composición original, isotipo sobre logotipo.
   */
  variant?: 'lockup' | 'mark' | 'wordmark' | 'stacked';
  /** Alto en px del elemento completo. El ancho sale del aspect ratio. */
  height?: number;
  class?: string;
  /**
   * Úsalo cuando al lado ya hay un texto que dice "Plateo": marca el SVG como
   * aria-hidden en vez de anunciarlo otra vez al lector de pantalla.
   */
  decorative?: boolean;
}

const { variant = 'lockup', height = 28, class: className, decorative = false } = Astro.props;

