---
/**
 * Jerarquía de botones. Regla: UN solo `primary` visible por pantalla.
 * Siempre renderiza <a> — en esta landing todo CTA es navegación.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  /** Añade target/rel de enlace externo. */
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className,
} = Astro.props;

const BASE =
  'inline-flex items-center justify-center gap-2 rounded-full font-medium transition duration-200 active:scale-[0.98]';

const VARIANTS = {
  primary: 'bg-brand-500 text-ink-950 hover:bg-brand-400',
  secondary: 'border border-ink-700 bg-ink-900/60 text-ink-100 hover:border-ink-500',
  ghost: 'text-ink-300 hover:text-ink-100',
} as const;

const SIZES = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
} as const;
---

<a
  href={href}
  class:list={[BASE, VARIANTS[variant], SIZES[size], className]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <slot />
</a>
