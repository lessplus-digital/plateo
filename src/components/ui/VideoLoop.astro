---
/**
 * Reemplazo de GIF. Un clip de producto en MP4/WebM pesa 10-20x menos que el
 * mismo GIF y se ve mejor. NO uses .gif en este sitio.
 *
 * Convertir con ffmpeg (los dos formatos, WebM primero por tamaño):
 *   ffmpeg -i clip.mov -vf "scale=1280:-2" -c:v libvpx-vp9 -crf 34 -b:v 0 -an clip.webm
 *   ffmpeg -i clip.mov -vf "scale=1280:-2" -c:v libx264 -crf 26 -pix_fmt yuv420p \
 *          -movflags +faststart -an clip.mp4
 *
 * Solo reproduce cuando está en pantalla: fuera del viewport se pausa y deja
 * de gastar CPU/batería.
 */
interface Props {
  /** Ruta al .mp4 en /public (fallback universal). */
  src: string;
  /** Ruta al .webm. Recomendado: lo sirve primero por ser más liviano. */
  webm?: string;
  /** Primer frame como imagen. Evita el hueco en blanco mientras carga. */
  poster?: string;
  /** Dimensiones intrínsecas: obligatorias para no romper el CLS. */
  width: number;
  height: number;
  /** Descripción para lectores de pantalla. */
  label: string;
  class?: string;
}

const { src, webm, poster, width, height, label, class: className } = Astro.props;
---

<video
  class={className}
  width={width}
  height={height}
  poster={poster}
  aria-label={label}
  autoplay
  muted
  loop
  playsinline
  preload="none"
  data-video-loop
>
  {webm && <source src={webm} type="video/webm" />}
  <source src={src} type="video/mp4" />
</video>

<script>
  // Pausa los clips fuera de pantalla. Con 4-5 loops en una landing esto es la
  // diferencia entre un ventilador encendido y un scroll suave.
  const videos = document.querySelectorAll<HTMLVideoElement>('[data-video-loop]');

  if (videos.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          const video = target as HTMLVideoElement;
          if (isIntersecting) {
            // `play()` rechaza si el navegador bloquea el autoplay: no es un error.
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.2 },
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>
