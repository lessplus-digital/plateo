---
/**
 * Carrusel sin dependencias: CSS scroll-snap + un script mínimo para las flechas.
 *
 * Por qué no una librería: scroll-snap ya da arrastre nativo, inercia, teclado
 * y touch gratis. Embla (~6 KB) solo hace falta si se necesita loop infinito
 * o autoplay real.
 *
 * Cada hijo del slot debe llevar `class="snap-start shrink-0"` y su propio ancho.
 *
 * El fundido de los bordes lo pone el componente sobre la PISTA, y se apaga en el
 * lado donde ya no queda contenido. No lo pases desde fuera con `mask-edges`:
 * aterriza en la raíz y el degradado se come los botones a medias.
 */
interface Props {
  /** Texto para lectores de pantalla que describe el conjunto. */
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;

const ARROW =
  'grid size-12 place-items-center rounded-full border-2 border-navy-900 bg-surface text-navy-900 transition duration-200 ease-out-cubic shadow-[2px_2px_0_0_var(--color-navy-900)] hover:bg-accent hover:-translate-y-0.5 hover:shadow-[3px_4px_0_0_var(--color-navy-900)] active:translate-y-0 active:shadow-[1px_1px_0_0_var(--color-navy-900)] disabled:pointer-events-none disabled:border-line-strong disabled:bg-surface disabled:text-text-faint disabled:shadow-none';
---

<div class:list={['relative', className]} data-carousel data-at-start data-at-end>
  <div
    class="mask-edges flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    role="region"
    aria-label={label}
    tabindex="0"
    data-carousel-track
  >
    <slot />
  </div>

  <div class="mt-4 flex justify-end gap-3">
    <button type="button" class={ARROW} aria-label="Anterior" data-carousel-prev>
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
      >
        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button type="button" class={ARROW} aria-label="Siguiente" data-carousel-next>
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
      >
        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  /*
    Sin contenido a un lado, no hay nada que insinuar: se quita el fundido para
    que la primera y la última tarjeta se vean enteras.
  */
  [data-carousel][data-at-start] [data-carousel-track] {
    --mask-start: 0rem;
  }

  [data-carousel][data-at-end] [data-carousel-track] {
    --mask-end: 0rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !prev || !next) return;

    /** Avanza el ancho de un slide (o el del viewport si no hay slides). */
    const step = () => {
      const slide = track.firstElementChild as HTMLElement | null;
      if (!slide) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || '0');
      return slide.offsetWidth + gap;
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      // Margen de 1px: los navegadores redondean scrollLeft y el botón
      // se quedaría habilitado para siempre al final del track.
      const atStart = track.scrollLeft <= 1;
      const atEnd = track.scrollLeft >= max - 1;

      prev.disabled = atStart;
      next.disabled = atEnd;

      // Los mismos dos estados gobiernan el fundido de los bordes (ver <style>).
      root.toggleAttribute('data-at-start', atStart);
      root.toggleAttribute('data-at-end', atEnd);
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });

    sync();
  });
</script>
