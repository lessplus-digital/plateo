---
import { NAV, SITE, LINKS } from '../../consts';

const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-ink-800/80">
  <div class="container-page flex flex-col gap-8 py-12 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-lg font-semibold tracking-tight">{SITE.name}</p>
      <p class="mt-1 max-w-xs text-sm text-ink-500">{SITE.description}</p>
    </div>

    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Pie de página">
      {
        NAV.map(({ label, href }) => (
          <a href={href} class="text-sm text-ink-300 transition-colors hover:text-ink-100">
            {label}
          </a>
        ))
      }
      <a
        href={`mailto:${LINKS.email}`}
        class="text-sm text-ink-300 transition-colors hover:text-ink-100"
      >
        Contacto
      </a>
    </nav>
  </div>

  <div class="container-page border-t border-ink-800/60 py-6">
    <p class="text-xs text-ink-500">© {year} {SITE.name}. Todos los derechos reservados.</p>
  </div>
</footer>
