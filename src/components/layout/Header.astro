---
import { NAV, SITE, LINKS } from '../../consts';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled]:border-line data-[scrolled]:bg-surface/85 data-[scrolled]:backdrop-blur-xl"
  data-header
>
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <a
      href="/"
      class="shrink-0 text-navy-900 transition-opacity hover:opacity-80"
      aria-label={`${SITE.name} — inicio`}
    >
      <Logo variant="lockup" height={22} decorative />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {
        NAV.map(({ label, href }) => (
          <a
            href={href}
            class="relative text-sm text-text-muted transition-colors hover:text-text"
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <Button href={LINKS.login} variant="ghost" size="sm" external class="hidden sm:inline-flex">
        Entrar al panel
      </Button>
      <Button href={LINKS.whatsapp} variant="primary" size="sm" external>Ver una demo</Button>
    </div>
  </div>
</header>

<script>
  // Fondo translúcido solo tras hacer scroll: el hero se ve limpio al cargar.
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (header) {
    const sync = () => {
      if (window.scrollY > 24) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };

    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
