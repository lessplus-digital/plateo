---
import { NAV, SITE } from '../../consts';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';

/**
 * Cabecera fija que se recoge al hacer scroll: arriba del todo va sin fondo y al
 * bajar se convierte en una píldora blanca.
 *
 * La barra NO cambia de ancho —su caja es la de `container-page` en los dos
 * estados—, así que el logo cae siempre en la misma vertical que el contenido.
 * Lo único que cambia es la piel: radio, fondo, borde y sombra.
 *
 * El estado vive en un `data-scrolled` sobre el <header>, que además es `group`;
 * las capas de dentro reaccionan con `group-data-[scrolled]:`. El JS solo pone y
 * quita atributos.
 *
 * Tres detalles que no son casuales:
 *
 * - Fondo blanco OPACO, no translúcido: sobre las secciones navy el morado se
 *   colaba por debajo del blur y la barra se veía sucia.
 * - Radio `2.25rem` y no `rounded-full`: al animar de 0 a 9999px el navegador
 *   recorta a la mitad de la altura en el primer 0.4% del recorrido y se ve un
 *   salto. 2.25rem son esos mismos 36px, y la curva se interpola entera.
 * - El borde existe siempre, transparente. Si apareciera con el scroll, la barra
 *   crecería 2px y el contenido daría un brinco.
 *
 * El corte del menú plegado está en `lg` y no en `md` porque en `md` no cabe:
 * logo (119px) + botón (159) + huecos (32) + menú (476) = 787px de contenido
 * contra los 704 que deja una ventana de 768. Acortar los rótulos era la
 * alternativa, y se descartó: nombran las mitades del producto (ver NAV).
 */
---

<header class="group fixed inset-x-0 top-0 z-50" data-header>
  {/*
    Capa 1: despega la barra del borde superior al hacer scroll. Solo vertical —
    un padding horizontal estrecharía la barra respecto al contenido.

    De este `pt` y del alto de la barra sale el `scroll-padding-top` de
    `global.css`: 1rem + 4.5rem = 5.5rem. Si cambias uno, cambia el otro o las
    anclas del menú caen descuadradas.
  */}
  <div
    class="relative transition-[padding] duration-500 ease-out-quart group-data-[scrolled]:pt-3 md:group-data-[scrolled]:pt-4"
  >
    {/* Capa 2: la barra. Mismo ancho siempre; lo que cambia es la piel. */}
    <div
      class:list={[
        'mx-auto flex h-16 max-w-[78rem] items-center justify-between gap-4 rounded-none border border-transparent px-5 md:h-18 md:px-8',
        'transition-[border-radius,background-color,border-color,box-shadow] duration-500 ease-out-quart',
        'group-data-[scrolled]:rounded-[2.25rem] group-data-[scrolled]:border-line group-data-[scrolled]:bg-surface',
        'group-data-[scrolled]:shadow-[0_10px_34px_-14px_oklch(0.262_0.098_283.8/0.35)]',
      ]}
    >
      <a
        href="/"
        class="shrink-0 text-navy-900 transition-opacity hover:opacity-80"
        aria-label={`${SITE.name} — inicio`}
      >
        <Logo variant="lockup" height={22} decorative />
      </a>

      {/* El padding negativo compensa el de los enlaces: cada uno lleva su caja
          para que el hover sea una píldora, sin que el menú se desplace. */}
      <nav class="hidden items-center lg:-mx-3 lg:flex" aria-label="Principal">
        {
          NAV.map(({ label, href }) => (
            <a
              href={href}
              class="rounded-full px-3 py-2 text-sm whitespace-nowrap text-text-muted transition-colors hover:bg-surface-sunken hover:text-text"
            >
              {label}
            </a>
          ))
        }
      </nav>

      {/*
        Un solo botón, y apunta al cierre de la página, no a WhatsApp: la demo se
        pide desde ahí, con el correo como alternativa.

        El `hidden lg:block` va en el <span> y NO en la clase del <Button />: su
        clase base lleva `inline-flex`, que gana a `hidden` por el orden en que
        Tailwind emite las reglas. Pasándoselo al componente, el botón se seguía
        viendo en móvil y salía dos veces. Mismo caso que las flechas de Steps.
      */}
      <span class="hidden shrink-0 lg:block">
        <Button href="/#contacto" variant="primary" size="sm">Agendar una demo</Button>
      </span>

      {/* 44px de lado: el mínimo que piden las pautas de accesibilidad para un
          objetivo táctil. Las rayas son un <svg> propio, como toda la iconografía. */}
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        class="menu-icon -mr-2 grid size-11 shrink-0 place-items-center rounded-full text-text transition-colors hover:bg-surface-sunken lg:hidden"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3.5 7h17" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
          <path d="M3.5 12h17" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
          ></path>
          <path d="M3.5 17h17" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>

    {/*
      Panel desplegable (todo lo que quede por debajo de `lg`). Es una tarjeta de
      papel —borde de 2px, sombra dura—, el mismo lenguaje de <Sticker />, y no
      un overlay a pantalla completa.

      Va `absolute` por dos razones: no aporta altura al <header> (en el flujo,
      su caja mediría siempre los ~290px del panel abierto y ese rectángulo
      invisible se comería los clics sobre el hero) y, como el header es `fixed`,
      abrirse no empuja nada — de ahí que no haga falta animar la altura.

      Cerrado no basta con que no se vea: los enlaces seguirían siendo tabulables.
      De eso se encarga el atributo `inert`, que pone el JS.
    */}
    <div
      id="menu-movil"
      data-menu-panel
      class="absolute inset-x-0 top-full mx-auto max-w-[78rem] px-5 md:px-8 lg:hidden"
    >
      <div
        class="mt-2 rounded-2xl border-2 border-text bg-surface p-3 shadow-[4px_4px_0_0_var(--text)]"
      >
        <nav class="grid" aria-label="Principal (menú plegado)">
          {
            NAV.map(({ label, href }) => (
              <a
                href={href}
                class="rounded-xl px-3 py-3 font-medium text-text transition-colors hover:bg-surface-sunken"
              >
                {label}
              </a>
            ))
          }
        </nav>

        <div class="mt-2 border-t border-line pt-3">
          <Button href="/#contacto" variant="primary" size="md" class="w-full">
            Agendar una demo
          </Button>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /*
    Apertura del panel. Va en CSS de componente y no en utilidades de Tailwind
    porque Tailwind v4 las emite dentro de `@layer utilities`, y una capa pierde
    siempre frente a los estilos sin capa —que es donde Astro pone esto—: un
    `data-[open]:opacity-100` se quedaba sin efecto aunque el selector casara.

    Solo se animan `opacity` y `translate`, las dos por compositor. El
    `prefers-reduced-motion` global ya recorta estas duraciones.
  */
  [data-menu-panel] {
    opacity: 0;
    translate: 0 -0.5rem;
    pointer-events: none;
    transition:
      opacity 0.2s var(--ease-out-quart),
      translate 0.2s var(--ease-out-quart);
  }

  [data-menu-panel][data-open] {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }

  /*
    Las tres rayas se cruzan en X al abrir. En SVG el `transform-origin` se
    resuelve contra el lienzo entero, no contra el trazo, así que sin
    `transform-box: fill-box` cada raya giraría alrededor de la esquina del
    viewBox y saldrían despedidas.
  */
  .menu-icon path {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.3s var(--ease-out-quart),
      opacity 0.2s linear;
  }

  .menu-icon[aria-expanded='true'] path:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  .menu-icon[aria-expanded='true'] path:nth-child(2) {
    opacity: 0;
  }

  .menu-icon[aria-expanded='true'] path:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  if (header && toggle && panel) {
    let menuOpen = false;

    /*
      Histéresis: entra en modo píldora a los 24px y no vuelve hasta los 8. Con un
      único umbral, pararse encima de él hace parpadear la barra en cada
      micro-scroll del trackpad.

      Con el menú abierto se fuerza el estado recogido: si no, el panel quedaría
      colgando de una barra transparente al abrirlo desde lo alto de la página.
    */
    let scrolled = false;

    const sync = () => {
      if (menuOpen) {
        header.setAttribute('data-scrolled', '');
        return;
      }

      const y = window.scrollY;

      if (!scrolled && y > 24) {
        scrolled = true;
        header.setAttribute('data-scrolled', '');
      } else if (scrolled && y < 8) {
        scrolled = false;
        header.removeAttribute('data-scrolled');
      } else if (!scrolled) {
        header.removeAttribute('data-scrolled');
      }
    };

    const setMenu = (open: boolean) => {
      menuOpen = open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      panel.toggleAttribute('data-open', open);
      panel.inert = !open;
      sync();
    };

    setMenu(false);
    sync();
    window.addEventListener('scroll', sync, { passive: true });

    toggle.addEventListener('click', () => setMenu(!menuOpen));

    // Elegir una sección navega y cierra. Sin esto el panel tapa justo aquello
    // a lo que se acaba de saltar.
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setMenu(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuOpen) {
        setMenu(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (menuOpen && !header.contains(e.target as Node)) setMenu(false);
    });

    // Al ensanchar a escritorio el panel se oculta por CSS, pero el estado
    // seguiría en "abierto" y el icono en aspa al volver a estrechar.
    // 64rem = el breakpoint `lg`, donde aparece el menú de la barra. Tiene que
    // seguir cuadrando con los `lg:` del marcado de arriba.
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && menuOpen) setMenu(false);
    });
  }
</script>
